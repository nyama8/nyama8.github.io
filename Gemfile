# Ruby packages ("gems") this site needs. Install them with `bundle install`.
# Exact versions are recorded in Gemfile.lock, which is also committed.
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-seo-tag"   # page titles, descriptions and link previews
  gem "jekyll-sitemap"   # sitemap.xml for search engines
end
